{
  "name": "@adagio/web",
  "version": "0.4.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:accessibility": "playwright test --project=accessibility",
    "clean": "rm -rf .next dist",
    "clean:e2e": "rm -rf playwright-report test-results"
  },
  "dependencies": {
    "@adagio/api-client": "workspace:*",
    "@adagio/auth": "workspace:*",
    "@adagio/database": "workspace:*",
    "@adagio/theory": "workspace:*",
    "@adagio/types": "workspace:*",
    "@adagio/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@vercel/analytics": "^1.6.1",
    "beta": "^0.0.1",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "immer": "^11.2.9",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "tonal": "^6.5.1",
    "tone": "^15.1.22",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@adagio/config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
