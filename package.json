{
  "name": "adagio",
  "version": "0.4.3",
  "private": true,
  "description": "Adagio - L'atlas harmonique intelligent pour guitaristes",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@adagio/web",
    "dev:api": "turbo run dev --filter=@adagio/api",
    "dev:mobile": "turbo run dev --filter=@adagio/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "sheet:import": "node scripts/import-sheet.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @adagio/database prisma generate",
    "db:push": "pnpm --filter @adagio/database prisma db push",
    "db:migrate": "pnpm --filter @adagio/database prisma migrate dev",
    "db:seed": "pnpm --filter @adagio/database tsx src/seed.ts",
    "db:studio": "pnpm --filter @adagio/database prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "qs": "6.17.1",
      "multer": "2.5.0",
      "lodash": "4.18.1",
      "js-yaml": "4.3.2",
      "postcss": "8.5.32",
      "@xmldom/xmldom": "0.8.15",
      "webpack": "5.112.2",
      "uuid": "11.1.1",
      "@mapbox/node-pre-gyp": "2.0.3",
      "tar": "7.5.22",
      "happy-dom": "21.0.4",
      "vite": "7.3.7"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "next-auth": "^4.24.15"
  }
}
